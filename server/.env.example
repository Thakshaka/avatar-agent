PORT=8787
FRONTEND_ORIGINS=http://localhost:5173,http://avatar.localhost:5173

# Keep this key on the server. Never put it in a VITE_* variable.
TAVUS_API_KEY=replace-with-your-tavus-api-key
TAVUS_PERSONA_ID=replace-with-your-persona-id
TAVUS_REPLICA_ID=replace-with-your-replica-id

TAVUS_API_URL=https://tavusapi.com/v2
TAVUS_CONVERSATION_NAME=Avatar Agent Demo
TAVUS_CONVERSATIONAL_CONTEXT=
DEFAULT_CALL_DURATION_SECONDS=300
MAX_CALL_DURATION_SECONDS=900
